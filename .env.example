# Скопируй в .env и подправь под себя: cp .env.example .env

# UID/GID host-пользователя — чтобы файлы из контейнера не были root-овыми.
# Узнать: `id -u` и `id -g`
UID=1000
GID=1000

# Имя проекта (префикс для контейнеров/сетей)
COMPOSE_PROJECT_NAME=test-task

# Порты на хосте
HTTP_PORT=8000
HTTPS_PORT=8443
MYSQL_PORT=3306
ADMINER_PORT=8080
MAILPIT_WEB_PORT=8025

# MySQL
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# Xdebug: off | develop,debug,coverage
XDEBUG_MODE=develop,debug,coverage
